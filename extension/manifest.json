{
  "manifest_version": 3,
  "name": "Markdown Viewer (local)",
  "version": "0.2.0",
  "description": "Renders local Markdown files (file://*.md) in the browser. No network access, no permissions beyond file URLs.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown",
        "file:///*.mdown",
        "file:///*.mkd"
      ],
      "js": ["vendor/marked.umd.js", "vendor/purify.min.js", "render.js"],
      "css": ["viewer.css"],
      "run_at": "document_end"
    }
  ]
}
